# Copy to .env.local and fill in. Never commit real values.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only, never expose

# Stripe (step 2)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (step 3)
RESEND_API_KEY=
EMAIL_FROM="Your Photo Tee <orders@yourdomain.my>"
ADMIN_NOTIFY_EMAIL=                 # your partner, for new-order alerts

# Vercel Cron (step 6)
CRON_SECRET=

# Restyle with AI (Gemini). Use a paid-tier key: on the free tier Google may use the photos to improve its products.
FEATURE_AI_RESTYLE=false
NEXT_PUBLIC_FEATURE_AI_RESTYLE=false
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image   # a "pro" image model gives sharper 2K/4K prints at a higher price
GEMINI_IMAGE_SIZE=2K                        # pro models only: 1K, 2K or 4K
AI_DAILY_LIMIT_PER_CUSTOMER=6
AI_DAILY_LIMIT_TOTAL=300

# Preview the shop without Supabase (products only; uploads and checkout won't work)
DEMO_MODE=false

# Phase 2: "Try it on me" (leave off)
FEATURE_TRYON=false
NEXT_PUBLIC_FEATURE_TRYON=false
FASHN_API_KEY=
TRYON_FREE_LIMIT=3
