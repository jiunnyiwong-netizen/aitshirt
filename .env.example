# Copy to .env.local and fill in. Never commit real values.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only, never expose

# Stripe (step 2)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (step 3)
RESEND_API_KEY=
EMAIL_FROM="Your Photo Tee <orders@yourdomain.my>"
ADMIN_NOTIFY_EMAIL=                 # your partner, for new-order alerts

# Vercel Cron (step 6)
CRON_SECRET=

# Phase 2: "Try it on me" (leave off)
FEATURE_TRYON=false
NEXT_PUBLIC_FEATURE_TRYON=false
FASHN_API_KEY=
TRYON_FREE_LIMIT=3
